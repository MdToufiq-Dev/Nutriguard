{
  "name": "nutriguard-server",
  "version": "1.0.0",
  "description": "NUTRIGUARD backend: Node.js + PostgreSQL, free LLM, OSM places",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "db:dev": "node scripts/db-dev.js",
    "db:migrate": "node-pg-migrate --dir src/db/migrations up",
    "db:seed": "node src/db/seeds/index.js",
    "db:check": "node scripts/db-check.js",
    "migrate": "node-pg-migrate --dir src/db/migrations",
    "migrate:up": "node-pg-migrate --dir src/db/migrations up",
    "migrate:down": "node-pg-migrate --dir src/db/migrations down",
    "seed": "node src/db/seeds/index.js",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "eval:llm": "node evals/runEvals.js"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^18.0.5",
    "express": "^5.0.0",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "node-cache": "^5.1.2",
    "node-pg-migrate": "^7.0.0",
    "opening_hours": "^3.6.2",
    "pg": "^8.23.1",
    "pino": "^8.17.2",
    "pino-http": "^8.6.1",
    "swagger-ui-express": "^5.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "eslint": "^8.54.0",
    "prettier": "^3.1.0",
    "supertest": "^6.3.3",
    "vitest": "^1.0.4"
  }
}
